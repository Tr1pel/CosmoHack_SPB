# Required only by `npm run spacetrack:fetch` or the Docker Compose `space-track` profile.
# Create a Space-Track account, accept its terms, then copy this file to .env and fill it in.
SPACE_TRACK_IDENTITY=you@example.com
SPACE_TRACK_PASSWORD=replace-with-your-password

# Optional for Docker Compose: where the app is published on the host.
# 127.0.0.1 keeps it behind nginx; 0.0.0.0 opens it to the network without a proxy.
# BIND_ADDRESS=127.0.0.1
# PORT=5173
